{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "../scripts/**/*.ts",
    "../scripts/**/*.js",
    "../scripts/**/*.mjs",
    "../eslint.config.js",
    "../vitest.config.ts",
    "../packages/*/src/**/*.test.ts",
    "../apps/*/src/**/*.test.ts"
  ],
  "exclude": ["dist", "../apps/desktop/src/renderer/**"],
  "references": [
    {
      "path": "../packages/protocol"
    },
    {
      "path": "../packages/core"
    },
    {
      "path": "../packages/storage"
    },
    {
      "path": "../packages/runtime-pi"
    },
    {
      "path": "../packages/tools"
    },
    {
      "path": "../packages/shell"
    },
    {
      "path": "../packages/checkpoint"
    },
    {
      "path": "../packages/skills"
    },
    {
      "path": "../packages/i18n"
    },
    {
      "path": "../apps/desktop/tsconfig.node.json"
    }
  ]
}
