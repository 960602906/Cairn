{
  "name": "spike-pi-utility-process",
  "version": "0.0.0",
  "private": true,
  "description": "S1：pi（pi-agent-core / pi-ai）能否在 Electron utilityProcess 中完成带工具调用的对话",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "node": "node src/cli.mjs",
    "electron": "electron .",
    "bundle": "vite build",
    "package": "electron-builder --dir --publish never",
    "summarize": "node src/summarize.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "dev.nexus-os.spike.pi-utility-process",
    "productName": "PiUtilityProcessSpike",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  },
  "author": "NEXUS-OS",
  "license": "UNLICENSED"
}
