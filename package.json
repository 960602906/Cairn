{
  "name": "cairn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @cairn/desktop dev",
    "build": "pnpm --filter @cairn/desktop build",
    "smoke": "pnpm --filter @cairn/desktop smoke",
    "e2e": "pnpm --filter @cairn/desktop e2e",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run packages/checkpoint/src/shadow-repo.perf.test.ts",
    "spike:m4": "vitest run --config spikes/m4/vitest.config.mts",
    "test:watch": "vitest",
    "contract:record": "vitest run packages/runtime-pi/src/contract-record.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "tsc -b --clean",
    "check:licenses": "node scripts/check-licenses.js",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
