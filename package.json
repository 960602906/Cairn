{
  "name": "nexus-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @nexus/desktop dev",
    "build": "pnpm --filter @nexus/desktop build",
    "smoke": "pnpm --filter @nexus/desktop smoke",
    "e2e": "pnpm --filter @nexus/desktop e2e",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "tsc -b --clean",
    "check:licenses": "node scripts/check-licenses.js",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
