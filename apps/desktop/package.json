{
  "name": "@cairn/desktop",
  "version": "0.1.0",
  "productName": "Cairn",
  "description": "Local-first desktop AI coding agent",
  "author": "Cairn contributors",
  "copyright": "Copyright © 2026 Cairn contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node ../../scripts/build-info.mjs && node ../../scripts/third-party-notices.js out/THIRD_PARTY_NOTICES.txt",
    "start": "electron-vite preview",
    "smoke": "node scripts/smoke.js",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "package:dir": "node scripts/packaging.mjs --dir",
    "package:nsis": "node scripts/packaging.mjs --nsis",
    "package:verify": "node scripts/verify-package.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:installed": "node scripts/smoke-installed.mjs",
    "acceptance:installed": "node scripts/acceptance-installed.mjs",
    "e2e:packaged": "playwright test -c e2e/packaged.config.ts"
  },
  "build": {
    "appId": "com.cairn.desktop"
  },
  "dependencies": {
    "@cairn/checkpoint": "workspace:*",
    "@cairn/core": "workspace:*",
    "@cairn/i18n": "workspace:*",
    "@cairn/mcp": "workspace:*",
    "@cairn/protocol": "workspace:*",
    "@cairn/runtime-pi": "workspace:*",
    "@cairn/shell": "workspace:*",
    "@cairn/skills": "workspace:*",
    "@cairn/storage": "workspace:*",
    "@cairn/tools": "workspace:*",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "i18next": "26.7.1",
    "koffi": "3.3.6",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "vscode-material-icons": "0.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.6",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cairn/release-tools": "workspace:*",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "es-module-lexer": "2.3.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  }
}
