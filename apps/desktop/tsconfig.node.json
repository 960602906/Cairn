{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/node",
    "tsBuildInfoFile": "dist/node.tsbuildinfo",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/main",
    "src/preload",
    "src/agent-host",
    "src/shared",
    "e2e",
    "electron.vite.config.ts",
    "scripts"
  ],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/storage"
    },
    {
      "path": "../../packages/i18n"
    }
  ]
}
